# =============================================================================
# DataHub 웹 포털 — 환경변수 예시
# 실제 값은 GitLab CI/CD Variables 또는 로컬 .env 파일에 설정
# .env 파일은 절대 커밋하지 마세요
# =============================================================================

# -----------------------------------------------------------------------------
# Database (Prisma)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<dbname>?schema=public

# -----------------------------------------------------------------------------
# NextAuth
# -----------------------------------------------------------------------------
# JWT 서명 키 — 안전한 랜덤 문자열 (예: openssl rand -base64 32)
NEXTAUTH_SECRET=

# 배포 URL — 브라우저에서 접근하는 공개 URL
# 로컬 개발: http://localhost:3000
# dev : https://dev.datahub.lgair-data.com
# stg : https://stg.datahub.lgair-data.com
# prd : https://datahub.lgair-data.com
NEXTAUTH_URL=https://datahub.lgair-data.com

# -----------------------------------------------------------------------------
# API 연결
# -----------------------------------------------------------------------------
# 브라우저에서 data-platform-api를 호출할 때 사용하는 공개 URL
# dev : https://api-dev.datahub.lgair-data.com
# stg : https://api-stg.datahub.lgair-data.com
# prd : https://api.datahub.lgair-data.com
NEXT_PUBLIC_PLATFORM_API_URL=https://api.datahub.lgair-data.com

# 서버 사이드에서 data-platform-api를 호출할 때 사용하는 내부 URL
# K8s 환경 (같은 ns): http://dh-platform.lgair-datahub.svc.cluster.local:8080
# 로컬 개발: http://localhost:8643
PLATFORM_API_INTERNAL_URL=http://dh-platform.lgair-datahub.svc.cluster.local:8080

# data-intelligence-api (DIA / AI Agent) 내부 URL
# K8s 환경 (같은 ns): http://dh-intelligence-agent.lgair-datahub.svc.cluster.local:8000
# 로컬 개발: http://localhost:8000
INTELLIGENCE_API_INTERNAL_URL=http://dh-intelligence-agent.lgair-datahub.svc.cluster.local:8000

# BFF → DIA 호출에 부착하는 X-Service-Token 발급용 HS256 secret.
# DIA helm 의 INTERNAL_SERVICE_INCOMING_SECRET 과 동일 값. >=32 chars.
# 미설정 시 BFF 의 /api/agent/* /api/catalog/ai/* 가 500 으로 fail-fast.
INTERNAL_SERVICE_SECRET_TO_DIA=

# 거버넌스 신청서 진행 이력 채팅 — Phase 1 고정 담당자 (신청자 ↔ 담당자 양방향 회신).
# Phase 2 에서 다수 담당자 / ROLE_MAPPING DB 전환 시 이 두 env 는 제거 예정.
GOVERNANCE_ASSIGNEE_EMAIL=kim.eunsol@company.com
GOVERNANCE_ASSIGNEE_NAME=김은솔

# ──────────────────────────────────────────────────────────────────────────
# ⚠️  LOCAL DEV ONLY — datahub-api 없이 UI 검증할 때만 사용. PRODUCTION 절대 X.
# ──────────────────────────────────────────────────────────────────────────
# 켜지면 middleware 가 platform_token 검사를 건너뛰고, getSession() 이 mock 세션을 반환.
# DEV_AUTH_BYPASS=1 일 때만 활성. dev / stg / prd 환경에는 절대 두지 말 것.
# DEV_AUTH_EMAIL 은 mock 사용자 이메일 (DB User 테이블의 row 도 이 email 로 upsert 됨).
# DEV_AUTH_ROLE 은 'USER' 또는 'ADMIN' (admin 페이지 접근 테스트용).
DEV_AUTH_BYPASS=0
DEV_AUTH_EMAIL=dev@localhost
DEV_AUTH_NAME=Dev User
DEV_AUTH_ROLE=ADMIN
