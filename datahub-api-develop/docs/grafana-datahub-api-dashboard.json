{
  "title": "DataHub API Control Plane",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "title": "HTTP Requests by Status",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (status) (rate(datahub_http_requests_total[5m]))",
          "legendFormat": "{{status}}"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
    },
    {
      "title": "HTTP Latency Sum by Path",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (path) (rate(datahub_http_request_duration_seconds_sum[5m]))",
          "legendFormat": "{{path}}"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
    },
    {
      "title": "Max Request Duration",
      "type": "timeseries",
      "targets": [
        {
          "expr": "max by (path) (datahub_http_request_duration_seconds_max)",
          "legendFormat": "{{path}}"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
    },
    {
      "title": "Process Uptime",
      "type": "stat",
      "targets": [
        {
          "expr": "datahub_process_uptime_seconds"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
    }
  ]
}
